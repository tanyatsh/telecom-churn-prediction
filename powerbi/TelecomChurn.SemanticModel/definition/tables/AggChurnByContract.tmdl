/// Descriptive churn aggregates at one row per contract category.
table AggChurnByContract
	lineageTag: b5d2845f-f946-48c8-81bb-8ad439deb399

	column contract
		dataType: string
		isKey
		lineageTag: 94c5261c-e1ac-4528-a508-1e4440cf5b59
		summarizeBy: none
		sourceColumn: contract

	column group_size
		dataType: int64
		lineageTag: 5d34998a-0a8f-4ca1-af60-443d6ae85a69
		summarizeBy: none
		sourceColumn: group_size

	column churned_customers
		dataType: int64
		lineageTag: 34441df2-171d-430d-93ab-ccf372ffff5b
		summarizeBy: none
		sourceColumn: churned_customers

	column churn_rate_pct
		dataType: double
		formatString: 0.00
		lineageTag: 58123371-32f6-4822-9665-50314de87f33
		summarizeBy: none
		sourceColumn: churn_rate_pct

	partition AggChurnByContract = m
		mode: import
		source = LoadCsv("outputs\eda\churn_by_contract.csv", 4, {{"contract", type text}, {"group_size", Int64.Type}, {"churned_customers", Int64.Type}, {"churn_rate_pct", type number}})

