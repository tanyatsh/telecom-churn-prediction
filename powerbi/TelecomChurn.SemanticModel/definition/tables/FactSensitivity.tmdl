		source = LoadCsv("outputs\powerbi\phase4a\v1\sensitivity_analysis_v1.csv", 10, {{"base_scenario", type text}, {"varied_parameter", type text}, {"varied_value", type number}, {"capacity_fraction", type number}, {"capacity_label", type text}, {"contacted_customers", Int64.Type}, {"net_expected_scenario_value", type number}, {"gross_expected_retained_contribution", type number}, {"total_campaign_cost", type number}, {"expected_prevented_churn", type number}})

