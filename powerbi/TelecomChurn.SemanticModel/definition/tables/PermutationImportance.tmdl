	partition PermutationImportance = m
		mode: import
		source = LoadCsv("artifacts\phase3b\v1\permutation_importance_v1.csv", 6, {{"feature", type text}, {"roc_auc_decrease_mean", type number}, {"roc_auc_decrease_std", type number}, {"pr_auc_decrease_mean", type number}, {"pr_auc_decrease_std", type number}, {"repeats", Int64.Type}})

