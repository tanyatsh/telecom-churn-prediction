	partition KPIModelTest = m
		mode: import
		source =
				let
					Root = Text.TrimEnd(DataRoot, {"\", "/"}),
					Metrics = Json.Document(File.Contents(Root & "\artifacts\phase3a\v1\test_metrics_v1.json")),
					Selected = Record.SelectFields(Metrics, {"baseline_pr_auc", "baseline_roc_auc", "brier_score", "expected_calibration_error_10_equal_count_bins", "illustrative_threshold", "lift_at_top_20_percent", "log_loss", "pr_auc", "precision_at_top_20_percent", "recall_at_top_20_percent", "roc_auc", "test_churned", "test_customers", "test_prevalence"}),
					AsTable = Table.FromRecords({Selected}),
					Typed = Table.TransformColumnTypes(AsTable, {{"baseline_pr_auc", type number}, {"baseline_roc_auc", type number}, {"brier_score", type number}, {"expected_calibration_error_10_equal_count_bins", type number}, {"illustrative_threshold", type number}, {"lift_at_top_20_percent", type number}, {"log_loss", type number}, {"pr_auc", type number}, {"precision_at_top_20_percent", type number}, {"recall_at_top_20_percent", type number}, {"roc_auc", type number}, {"test_churned", Int64.Type}, {"test_customers", Int64.Type}, {"test_prevalence", type number}}, "en-US")
				in
					Typed

