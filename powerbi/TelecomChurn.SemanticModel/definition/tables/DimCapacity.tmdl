/// Three validated fixed contact capacities with retrospective held-out performance.
table DimCapacity
	lineageTag: c392cc2c-39e1-4449-8bc3-af081d8c755d

	/// Contacted customers at the single selected fixed capacity.
	measure 'Fixed Contacted Customers' = SELECTEDVALUE(DimCapacity[contacted_customers])
		formatString: #,##0
		displayFolder: Fixed Capacity KPIs
		lineageTag: 8a217453-f3ce-4cb7-a040-ec0ffc636769

	/// Retrospective held-out churn capture at the single selected capacity.
	measure 'Fixed Observed Churn Capture' = SELECTEDVALUE(DimCapacity[observed_churn_capture])
		formatString: 0.00%
		displayFolder: Fixed Capacity KPIs
		lineageTag: 0ab565b5-e149-484a-884b-bc6eab279ee2

	/// Retrospective held-out precision at the single selected capacity.
	measure 'Fixed Capacity Precision' = SELECTEDVALUE(DimCapacity[precision])
		formatString: 0.00%
		displayFolder: Fixed Capacity KPIs
		lineageTag: d0460fe3-ff8d-4b43-962c-f143f4078b8d

	/// Retrospective held-out lift at the single selected capacity.
	measure 'Fixed Capacity Lift' = SELECTEDVALUE(DimCapacity[lift])
		formatString: 0.0000
		displayFolder: Fixed Capacity KPIs
		lineageTag: 1676e012-05f7-49b2-83b2-ddf0d0d54f60

	column capacity_fraction
		dataType: double
		isKey
		formatString: 0%
