/// Static validation/reference outcomes at one row per scenario and capacity.
/// These rows do not respond to disconnected what-if parameters.
table FactScenarioOutcome
	lineageTag: 44ae743d-ddc3-4590-bcbb-941fc0d078c9

	/// Static scenario net value; requires one scenario and one capacity.
	measure 'Static Scenario Net Expected Value' = SELECTEDVALUE(FactScenarioOutcome[net_expected_scenario_value])
		formatString: #,##0.00
		displayFolder: Static Scenario Reference
		lineageTag: 0d5f86cc-ca94-4a75-a04e-bce49b301bb4

	/// Static expected prevented churn; requires one scenario and one capacity.
	measure 'Static Expected Prevented Churn' = SELECTEDVALUE(FactScenarioOutcome[expected_prevented_churn])
		formatString: #,##0.00
		displayFolder: Static Scenario Reference
		lineageTag: 38deb3d0-2b87-4ecb-a9f2-5e52df8f3386

	/// Static break-even effectiveness; requires one scenario and one capacity.
	measure 'Static Break-Even Effectiveness' = SELECTEDVALUE(FactScenarioOutcome[break_even_effectiveness])
		formatString: 0.00%
		displayFolder: Static Scenario Reference
		lineageTag: 8e6c582f-0a2b-4093-98ba-039a1a2066a5

