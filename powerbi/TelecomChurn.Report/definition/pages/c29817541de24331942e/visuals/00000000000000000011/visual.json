                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#423f3a"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Fiber optic (41.9%) and electronic check (45.3%) are large, high-rate segments.",
