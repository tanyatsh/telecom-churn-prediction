            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "DECISION BOUNDARIES",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9px",
                      "color": "#c56a3d"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How to read this page",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "15px",
                      "color": "#2c2b29"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Dynamic outputs use frozen predicted probabilities and selected hypothetical inputs—not actual churn outcomes.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#5f5a54"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Effectiveness is a relative reduction in predicted churn risk. Contact and offer costs are incurred once per contacted customer.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#5f5a54"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Monetary outputs are illustrative currency units, not actual profit, verified ROI, or customer lifetime value.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#5f5a54"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Predictions do not estimate causal treatment uplift. Retrospective capacity metrics use held-out labels only in aggregate; no temporal validation was performed.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#5f5a54"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
